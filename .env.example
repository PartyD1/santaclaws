# NemoClaw / OpenShell
NEMOCLAW_SANDBOX_NAME=mainstreet
NEMOCLAW_PROVIDER=nvidia
NEMOCLAW_NON_INTERACTIVE=1
NEMOCLAW_ACCEPT_THIRD_PARTY_SOFTWARE=1
NEMOCLAW_WORKSPACE=/workspace/mainstreet/agents

# Nemotron
# Inside NemoClaw/OpenShell, prefer https://inference.local/v1.
# Outside the sandbox for local dev, use https://integrate.api.nvidia.com/v1.
NVIDIA_API_KEY=
NEMOTRON_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NEMOTRON_BASE_URL=https://inference.local/v1

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Apify
APIFY_TOKEN=

# Resend
RESEND_API_KEY=
OUTREACH_FROM_ADDRESS=

# SMTP email fallback for personal Gmail/Outlook/custom inboxes.
# Set EMAIL_PROVIDER=smtp to send through these values instead of Resend.
EMAIL_PROVIDER=resend
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Vercel
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
VERCEL_PROJECT_NAME=mainstreet-mockups

# Google Calendar
GCAL_CLIENT_ID=
GCAL_CLIENT_SECRET=
GCAL_REFRESH_TOKEN=

# Vapi (stretch)
VAPI_API_KEY=
VAPI_PHONE_NUMBER=
VAPI_WEBHOOK_URL=
VAPI_WEBHOOK_PORT=8787

# Discord
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_APPROVAL_CHANNEL_ID=

# Runtime flags
AUTONOMOUS_MODE=false
IGNORE_QUIET_HOURS=true
DESIGNER_USE_NEMOTRON_HTML=false
